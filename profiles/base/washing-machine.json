      "name": "Time remaining",
      "kind": "sensor",
      "ha": {
        "device_class": "duration",
        "unit_of_measurement": "min",
        "state_class": "measurement",
        "accuracy_decimals": 0
      }
    },
    {
      "id": "program",
      "from": "program",
      "name": "Programme",
      "kind": "text_sensor"
    },
    {
      "id": "state_2",
