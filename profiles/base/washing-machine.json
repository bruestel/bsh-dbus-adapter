{
  "schema": 1,
  "profile": {
    "id": "washing-machine",
    "model": "Generic washing machine",
    "appliance": "washing_machine",
    "generic": true,
    "note": "Shared decoding, factored from the model profiles. Usable on its own for an appliance of this family whose exact model has not been mapped: the values are correct, but codes are reported raw because programme names differ per model."
