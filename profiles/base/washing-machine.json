      "name": "Status 2",
      "kind": "text_sensor"
    },
    {
      "id": "temperature",
      "name": "Temperature",
      "match": {
        "dest": "0x14",
        "cmd": "0x1004",
        "min_len": 1
      },
      "extract": {
        "op": "u8",
        "at": 0
      }
    },
