    {
      "id": "machine_time_remaining",
      "from": "remain",
      "name": "Time remaining",
      "kind": "sensor",
      "transforms": [
        {
          "op": "divide",
          "value": 60
        }
      ],
      "ha": {
        "icon": "mdi:clock-outline"
      }
    },
    {
      "id": "machine_time_remaining_from_process",
      "name": "Time remaining, computed",
      "kind": "sensor",
      "match": {
        "dest": "0x21",
        "cmd": "0x1004",
        "min_len": 3
      },
      "extract": {
        "op": "u16be",
        "at": 1
      },
      "transforms": [
        {
          "op": "divide",
          "value": 60
        }
      ],
      "ha": {
        "device_class": "duration",
        "unit_of_measurement": "min",
        "state_class": "measurement",
        "icon": "mdi:clock-outline",
        "entity_category": "diagnostic",
        "accuracy_decimals": 0
      }
    },
    {
      "id": "machine_power_on",
      "name": "Powered on",
      "kind": "binary_sensor",
      "match": {
        "dest": "0x11",
        "cmd": "0x1001",
        "min_len": 1
      },
      "extract": {
        "op": "eq",
        "at": 0,
        "value": 37,
        "invert": true
      },
      "ha": {
        "device_class": "power"
      }
    },
    {
      "id": "machine_speed_perfect",
      "from": "feat_speedperfect",
      "name": "SpeedPerfect",
      "kind": "binary_sensor",
      "ha": {
        "icon": "mdi:fast-forward"
      }
    },
    {
      "id": "machine_pre_wash",
      "from": "feat_prewash",
      "name": "Pre-wash",
      "kind": "binary_sensor",
      "ha": {
        "icon": "mdi:feather"
      }
    },
    {
      "id": "machine_rinse_plus",
      "name": "Extra rinse",
      "kind": "binary_sensor",
      "match": {
        "dest": "0x11",
        "cmd": "0x1006",
        "min_len": 6
      },
      "extract": {
        "op": "bits",
        "at": 5,
        "shift": 0,
        "mask": 18
      },
      "transforms": [
        {
          "op": "lookup",
          "rules": [
            {
              "in": [
                18
              ],
              "out": true
            }
          ],
          "default": false
        }
      ],
      "ha": {
        "icon": "mdi:water-plus"
      }
    },
    {
      "id": "machine_door",
      "name": "Door",
      "kind": "binary_sensor",
      "match": {
        "dest": "0x21",
        "cmd": "0x1000",
        "min_len": 2
      },
      "extract": {
        "op": "u8",
        "at": 1
      },
      "transforms": [
        {
          "op": "lookup",
          "rules": [
            {
              "in": [
                3,
                57
              ],
              "out": true
            },
            {
              "in": [
                6,
                7,
                22
              ],
              "out": false
            }
          ],
          "default": "hold"
        }
      ],
      "ha": {
        "device_class": "door"
      }
    },
    {
