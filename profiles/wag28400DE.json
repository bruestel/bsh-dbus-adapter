  "entities": [
    {
      "id": "machine_spin_speed",
      "name": "Spin speed",
      "kind": "sensor",
      "match": {
        "dest": "0x11",
        "cmd": "0x1006",
        "min_len": 5
      },
      "extract": {
        "op": "u8",
        "at": 4
      },
      "transforms": [
        {
          "op": "lookup",
          "rules": [
            {
              "in": [
                1
              ],
              "out": 0
            }
          ],
          "default": "hold"
        }
      ],
      "ha": {
        "unit_of_measurement": "U/min",
        "state_class": "measurement",
        "icon": "mdi:rotate-right",
        "accuracy_decimals": 0
      }
    },
    {
      "id": "machine_unbalance_x",
      "name": "Unbalance X",
      "kind": "sensor",
      "match": {
        "dest": "0x17",
        "cmd": "0x4011",
        "min_len": 3
      },
      "extract": {
        "op": "i16be",
        "at": 1
      },
      "behavior": {
        "throttle_ms": 30000,
        "expire_after_s": 90
      },
      "ha": {
        "icon": "mdi:axis-x-rotate-clockwise",
        "entity_category": "diagnostic",
        "accuracy_decimals": 0
      }
    },
    {
      "id": "machine_unbalance_z",
      "name": "Unbalance Z",
      "kind": "sensor",
      "match": {
        "dest": "0x17",
        "cmd": "0x4011",
        "min_len": 5
      },
      "extract": {
        "op": "i16be",
        "at": 3
      },
      "behavior": {
        "throttle_ms": 30000,
        "expire_after_s": 90
      },
      "ha": {
        "icon": "mdi:axis-z-rotate-clockwise",
        "entity_category": "diagnostic",
        "accuracy_decimals": 0
      }
    },
    {
      "id": "machine_unbalance_y",
      "name": "Unbalance Y",
      "kind": "sensor",
      "match": {
        "dest": "0x17",
        "cmd": "0x4011",
        "min_len": 7
      },
      "extract": {
        "op": "i16be",
        "at": 5
      },
      "behavior": {
        "throttle_ms": 30000,
        "expire_after_s": 90
      },
      "ha": {
        "icon": "mdi:axis-y-rotate-clockwise",
        "entity_category": "diagnostic",
